{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oman-earth-intelligence-practice",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "observability": { "enabled": true },
  // Public, approximate per-route upstream safety budgets (per Cloudflare POP).
  // They protect NASA and Workers AI from bursts; NOT per-user authentication.
  "ratelimits": [
    {"name":"NASA_RATE","namespace_id":"910241","simple":{"limit":120,"period":60}},
    {"name":"AI_RATE","namespace_id":"910242","simple":{"limit":20,"period":60}}
  ],
  // To enable optional billed AI, uncomment the following binding and redeploy:
  // "ai": { "binding": "AI" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
